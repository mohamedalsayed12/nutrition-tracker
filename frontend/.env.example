# This backend is not on port 5000. The project README runs Flask on 8000.
# The server used while building this frontend is http://127.0.0.1:8765.
VITE_API_URL=http://127.0.0.1:8765

# Set to true to prefer mock handlers. The only unbuilt endpoint, food score, is always mocked.
VITE_USE_MOCKS=false
